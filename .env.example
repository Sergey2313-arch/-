# ReviMarket environment variables example
# ВАЖНО: это только пример. Настоящие секреты НЕ добавлять в GitHub.

ASPNETCORE_ENVIRONMENT=Development

# Database
REVIMARKET_DB_CONNECTION=Server=localhost;Database=ReviMarketDb;Trusted_Connection=True;TrustServerCertificate=True;

# Auth / JWT
REVIMARKET_JWT_ISSUER=ReviMarket
REVIMARKET_JWT_AUDIENCE=ReviMarketUsers
REVIMARKET_JWT_SECRET=change-this-secret-locally

# Payment provider
# Use Test for local demo payments or YooKassa for real payments.
# For production set PAYMENT_PROVIDER=YooKassa and keep secrets outside Git.
PAYMENT_PROVIDER=Test
PAYMENT_CURRENCY=RUB
PAYMENT_SHOP_ID=your_yookassa_shop_id
PAYMENT_SECRET_KEY=your_yookassa_secret_key
PAYMENT_RETURN_URL=https://example.com/Payments/Return/{invoiceId}
PAYMENT_YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3/

# YooKassa webhook URL:
# https://example.com/api/payments/yookassa

# Upload settings
UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf

# Mail settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASSWORD=change-this-password-locally
