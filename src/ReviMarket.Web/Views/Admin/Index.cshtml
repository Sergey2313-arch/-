@{
    ViewData["Title"] = "Админ-панель";
}

<section class="section-head">
    <div>
        <p class="eyebrow">admin panel</p>
        <h1>Админ-панель ReviMarket</h1>
        <p>Операционная панель для управления биржей.</p>
    </div>
</section>

<section class="admin-grid">
    <article class="card"><span class="tag">Users</span><h3>@ViewBag.UsersCount</h3><p>зарегистрированных пользователей</p></article>
    <article class="card"><span class="tag">Orders</span><h3>@ViewBag.OrdersCount</h3><p>заказов на бирже</p></article>
    <article class="card"><span class="tag">Messages</span><h3>@ViewBag.MessagesCount</h3><p>сообщений в системе</p></article>
    <article class="card"><span class="tag">Support</span><h3>@ViewBag.SupportCount</h3><p>открытых обращений</p></article>
</section>

<section class="section-block neon-card">
    <h2>Разделы управления</h2>
    <div class="profile-tabs">
        <a class="btn btn-primary" href="/Moderation">Модерация</a>
        <a class="btn btn-soft" href="/Support/Queue">Поддержка</a>
        <a class="btn btn-soft" href="/AdminFinance">Финансы</a>
        <a class="btn btn-soft" href="/Team">Команда</a>
    </div>
</section>
