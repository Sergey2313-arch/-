@model InboxIndexViewModel
@{
    ViewData["Title"] = "Сообщения";
}

<section class="section-head">
    <div>
        <p class="eyebrow">inbox</p>
        <h1>Сообщения</h1>
        <p>Диалоги между заказчиками, исполнителями и пользователями ReviMarket.</p>
    </div>
    <div class="section-actions">
        <a class="btn btn-soft" asp-controller="Profile" asp-action="Index">← Назад в профиль</a>
        <a class="btn btn-primary" asp-controller="Support" asp-action="Create">Написать в поддержку</a>
    </div>
</section>

@if (Model.Conversations.Any())
{
    <section class="section-block neon-card">
        <h2>Диалоги</h2>
        <div class="admin-list">
            @foreach (var conversation in Model.Conversations)
            {
                <div class="admin-row">
                    <div>
                        <b>@conversation.User.DisplayName</b>
                        <p>@conversation.LatestMessage.Text</p>
                        <small>@conversation.MessagesCount сообщений • @conversation.LatestMessage.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <a class="btn btn-soft" asp-action="Thread" asp-route-id="@conversation.User.Id">Открыть</a>
                </div>
            }
        </div>
    </section>
}
else
{
    <section class="neon-card empty">
        <h2>Сообщений пока нет</h2>
        <p>Открой профиль пользователя, заказ или выбери контакт ниже, чтобы начать диалог.</p>
    </section>
}

<section class="section-block neon-card">
    <h2>Пользователи</h2>
    <div class="grid">
        @foreach (var user in Model.Contacts)
        {
            <article class="card">
                <span class="tag">@DisplayRole(user)</span>
                <h3>@user.DisplayName</h3>
                <p>@DisplayLegalType(user) • ★ @user.Rating.ToString("0.00")</p>
                <a class="btn btn-primary" asp-action="Thread" asp-route-id="@user.Id">Написать</a>
            </article>
        }
    </div>
</section>

@functions {
    string DisplayRole(ApplicationUser user) => user.AccountType == UserRoles.Creator ? "Исполнитель" : user.AccountType == UserRoles.Customer ? "Заказчик" : user.AccountType;

    string DisplayLegalType(ApplicationUser user) => user.LegalType == AccountLegalTypes.Business ? "ИП / юрлицо" : "физлицо";
}
