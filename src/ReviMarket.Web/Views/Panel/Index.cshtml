@{
    ViewData["Title"] = "Панель";
    var currentUser = ViewBag.User as ApplicationUser;
    var accountType = currentUser?.AccountType ?? "User";
    var isAdmin = User.IsInRole(UserRoles.Admin) || accountType == UserRoles.Admin;
    var isManager = User.IsInRole(UserRoles.Manager) || accountType == UserRoles.Manager;
    var isOwner = accountType == UserRoles.Owner || accountType == UserRoles.CoOwner || isManager;
    var canSeeAdmin = isOwner || isAdmin;
    var canSeeFinance = isOwner || isAdmin;
    var canSeeModeration = isOwner || isAdmin || User.IsInRole(UserRoles.Moderator) || accountType == UserRoles.Moderator;
    var canSeeSupport = isOwner || isAdmin || User.IsInRole(UserRoles.SupportAgent) || accountType == UserRoles.SupportAgent;
    var canSeeTeam = isOwner || isAdmin;
}

<div class="admin-shell">
    <aside class="admin-sidebar neon-card">
        <div class="admin-logo">
            <div class="admin-logo-mark">R</div>
            <div><b>ReviMarket</b><small>@accountType</small></div>
        </div>

        <nav class="admin-menu">
            <a class="active" href="#dashboard">Dashboard</a>
            @if (canSeeAdmin) { <a href="/Admin">Администрация</a> }
            @if (canSeeModeration) { <a href="/Moderation">Модерация</a> }
            @if (canSeeSupport) { <a href="/Support/Queue">Поддержка</a> }
            @if (canSeeFinance) { <a href="/AdminFinance">Финансы</a> }
            @if (canSeeTeam) { <a href="/Team">Команда</a> }
            <a href="/Inbox">Сообщения</a>
            <a href="/Profile">Профиль</a>
        </nav>

        <div class="admin-note">
            <b>Доступ по ролям</b><br />
            Разделы показываются в зависимости от роли аккаунта.
        </div>
    </aside>

    <main class="admin-main">
        <section id="dashboard" class="admin-top">
            <div>
                <p class="eyebrow">moderation / support / security</p>
                <h1>Панель управления</h1>
                <p>Заказы, сделки, обращения, сообщения, модерация и команда.</p>
            </div>
            <div class="admin-badge"><b>@currentUser?.DisplayName</b><span>@accountType</span></div>
        </section>

        <section class="admin-stats">
            <article class="admin-stat neon-card"><span>Заказы</span><h3>@ViewBag.AllOrdersCount</h3><p>всего на бирже</p></article>
            <article class="admin-stat neon-card"><span>В работе</span><h3>@ViewBag.InWorkOrdersCount</h3><p>заказов с исполнителем</p></article>
            <article class="admin-stat neon-card"><span>Сделки</span><h3>@ViewBag.ActiveDealsCount</h3><p>активный холд</p></article>
            <article class="admin-stat neon-card"><span>Поддержка</span><h3>@ViewBag.OpenSupportCount</h3><p>открытых обращений</p></article>
        </section>

        <section class="admin-grid">
            @if (canSeeAdmin)
            {
                <article class="card">
                    <span class="tag">Admin</span>
                    <h3>Администрация</h3>
                    <p>Пользователи, роли, блокировки, быстрые очереди и операционные разделы.</p>
                    <a class="btn btn-primary" href="/Admin">Открыть</a>
                </article>
            }
            @if (canSeeModeration)
            {
                <article class="card">
                    <span class="tag">Moderation</span>
                    <h3>Модерация</h3>
                    <p>Проверка заказов, сообщений, жалоб и блокировок пользователей.</p>
                    <a class="btn btn-primary" href="/Moderation">Открыть</a>
                </article>
            }
            @if (canSeeSupport)
            {
                <article class="card">
                    <span class="tag">Support</span>
                    <h3>Поддержка</h3>
                    <p>Очередь тикетов и связь с пользователями через чат.</p>
                    <a class="btn btn-primary" href="/Support/Queue">Открыть</a>
                </article>
            }
            @if (canSeeFinance)
            {
                <article class="card">
                    <span class="tag">Finance</span>
                    <h3>Финансы</h3>
                    <p>Холд, выплаты, комиссии и заявки на вывод.</p>
                    <a class="btn btn-soft" href="/AdminFinance">Открыть</a>
                </article>
            }
            @if (canSeeTeam)
            {
                <article class="card">
                    <span class="tag">Team</span>
                    <h3>Команда</h3>
                    <p>Роли админов, модераторов и агентов поддержки.</p>
                    <a class="btn btn-soft" href="/Team">Открыть</a>
                </article>
            }
        </section>
    </main>
</div>
