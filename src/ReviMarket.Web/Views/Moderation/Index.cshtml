@model ModerationDashboardViewModel
@{
    ViewData["Title"] = "Модерация";
}

<section class="section-head">
    <div>
        <p class="eyebrow">moderation</p>
        <h1>Модерация</h1>
        <p>Очередь заказов, жалобы, споры, сообщения, пользователи и обращения поддержки.</p>
    </div>
    <a class="btn btn-soft" asp-controller="Panel" asp-action="Index">В панель</a>
</section>

@if (TempData["ModerationNotice"] is string notice)
{
    <section class="admin-note">
        <b>Готово</b>
        <span>@notice</span>
    </section>
}

<section class="admin-stats">
    <div class="stat-card neon-card"><span>Заказы</span><b>@Model.Orders.Count</b></div>
    <div class="stat-card neon-card"><span>Жалобы</span><b>@(Model.OrderCases.Count + Model.UserCases.Count)</b></div>
    <div class="stat-card neon-card"><span>Сообщения</span><b>@Model.Messages.Count</b></div>
    <div class="stat-card neon-card"><span>Поддержка</span><b>@Model.SupportRequests.Count</b></div>
</section>

<section class="section-block neon-card">
    <h2>Заказы</h2>
    <div class="admin-list">
        @foreach (var item in Model.Orders)
        {
            <div class="admin-row">
                <div>
                    <b>@item.Title</b>
                    <p>@item.Description</p>
                    <small>@item.Category • @item.Price.ToString("N0") ₽ • @(item.Owner?.DisplayName ?? "заказчик") • @DisplayReviewStatus(item.ReviewStatus)</small>
                </div>
                <div class="review-actions">
                    <span class="tag">@DisplayReviewStatus(item.ReviewStatus)</span>
                    <a class="btn btn-soft" asp-controller="Orders" asp-action="Details" asp-route-id="@item.Id">Открыть</a>
                    <form asp-action="ApproveOrder" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-primary" type="submit">Опубликовать</button>
                    </form>
                    <form asp-action="ReturnOrder" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-soft" type="submit">На проверку</button>
                    </form>
                    <form asp-action="BlockOrder" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-soft" type="submit">Скрыть</button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>

<section class="section-block neon-card">
    <h2>Жалобы и споры по заказам</h2>
    <div class="admin-list">
        @foreach (var item in Model.OrderCases)
        {
            <div class="admin-row">
                <div>
                    <b>@item.Title</b>
                    <p>@item.Text</p>
                    <small>@DisplayCaseStatus(item.Status) • @(item.CreatedBy?.DisplayName ?? "пользователь") • исполнитель: @(item.Agent?.DisplayName ?? "не назначен") • @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <div class="review-actions">
                    @if (item.MarketItemId is not null)
                    {
                        <a class="btn btn-soft" asp-controller="Orders" asp-action="Details" asp-route-id="@item.MarketItemId">Заказ</a>
                        <form asp-action="BlockOrder" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MarketItemId" />
                            <button class="btn btn-soft" type="submit">Скрыть заказ</button>
                        </form>
                        <form asp-action="ApproveOrder" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MarketItemId" />
                            <button class="btn btn-primary" type="submit">Одобрить заказ</button>
                        </form>
                    }
                    <partial name="_CaseStatusActions" model='@(new CaseActionViewModel { Id = item.Id, Action = "SetOrderCaseStatus" })' />
                </div>
            </div>
        }
    </div>
</section>

<section class="section-block neon-card">
    <h2>Жалобы на пользователей</h2>
    <div class="admin-list">
        @foreach (var item in Model.UserCases)
        {
            var locked = item.TargetUser?.LockoutEnd is not null && item.TargetUser.LockoutEnd > DateTimeOffset.UtcNow;
            <div class="admin-row">
                <div>
                    <b>@item.Title</b>
                    <p>@item.Text</p>
                    <small>@DisplayCaseStatus(item.Status) • жалоба от @(item.CreatedBy?.DisplayName ?? "пользователь") • модератор: @(item.Agent?.DisplayName ?? "не назначен") • @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <div class="review-actions">
                    @if (item.TargetUser is not null)
                    {
                        <a class="btn btn-soft" asp-controller="Profile" asp-action="Public" asp-route-id="@item.TargetUserId">Профиль</a>
                        if (locked)
                        {
                            <form asp-action="UnlockUser" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.TargetUserId" />
                                <button class="btn btn-primary" type="submit">Разблокировать</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="LockUser" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.TargetUserId" />
                                <button class="btn btn-soft" type="submit">Заблокировать</button>
                            </form>
                        }
                    }
                    <partial name="_CaseStatusActions" model='@(new CaseActionViewModel { Id = item.Id, Action = "SetUserCaseStatus" })' />
                </div>
            </div>
        }
    </div>
</section>

<section class="section-block neon-card">
    <h2>Сообщения</h2>
    <div class="admin-list">
        @foreach (var message in Model.Messages)
        {
            <div class="admin-row">
                <div>
                    <b>@(message.Sender?.DisplayName ?? "Отправитель") → @(message.Receiver?.DisplayName ?? "Получатель")</b>
                    <p>@message.Text</p>
                    <small>@message.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <form asp-action="DeleteMessage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@message.Id" />
                    <button class="btn btn-soft" type="submit">Удалить</button>
                </form>
            </div>
        }
    </div>
</section>

<section class="section-block neon-card">
    <h2>Пользователи</h2>
    <div class="admin-list">
        @foreach (var user in Model.Users)
        {
            var locked = user.LockoutEnd is not null && user.LockoutEnd > DateTimeOffset.UtcNow;
            <div class="admin-row">
                <div>
                    <b>@user.DisplayName</b>
                    <p>@user.Email • @user.AccountType • @user.LegalType</p>
                    <small>создан @user.CreatedAt.ToString("dd.MM.yyyy") • @(locked ? "заблокирован" : "активен")</small>
                </div>
                <div class="review-actions">
                    <a class="btn btn-soft" asp-controller="Profile" asp-action="Public" asp-route-id="@user.Id">Профиль</a>
                    @if (locked)
                    {
                        <form asp-action="UnlockUser" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <button class="btn btn-primary" type="submit">Разблокировать</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="LockUser" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <button class="btn btn-soft" type="submit">Заблокировать</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section class="section-block neon-card">
    <h2>Открытые обращения</h2>
    <div class="admin-list">
        @foreach (var request in Model.SupportRequests)
        {
            <div class="admin-row">
                <div>
                    <b>@request.Title</b>
                    <p>@request.Text</p>
                    <small>@request.Priority • @DisplayCaseStatus(request.Status) • @(request.User?.DisplayName ?? "пользователь") • агент: @(request.Agent?.DisplayName ?? "не назначен")</small>
                </div>
                <div class="review-actions">
                    <a class="btn btn-soft" asp-controller="Support" asp-action="Details" asp-route-id="@request.Id">Открыть</a>
                    <partial name="_CaseStatusActions" model='@(new CaseActionViewModel { Id = request.Id, Action = "SetSupportStatus" })' />
                </div>
            </div>
        }
    </div>
</section>

@functions {
    string DisplayReviewStatus(string status) => status switch
    {
        ReviewStatuses.Approved => "опубликован",
        ReviewStatuses.Blocked => "скрыт",
        _ => "на проверке"
    };

    string DisplayCaseStatus(string status) => status switch
    {
        CaseStatuses.InProgress => "в работе",
        CaseStatuses.Done => "закрыто",
        _ => "открыто"
    };
}
