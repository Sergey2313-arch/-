@model ApplicationUser
@{
    ViewData["Title"] = Model.DisplayName;
    var reviews = ViewBag.Reviews as List<UserReview> ?? new();
    var isOnline = ViewBag.IsOnline as bool? ?? false;
}

@if (TempData["ReportSuccess"] is string reportSuccess)
{
    <section class="admin-note">
        <b>Жалоба отправлена</b>
        <span>@reportSuccess</span>
    </section>
}
@if (TempData["ReportInfo"] is string reportInfo)
{
    <section class="admin-note">
        <b>Жалоба не отправлена</b>
        <span>@reportInfo</span>
    </section>
}

<section class="profile-page neon-card">
    <p class="eyebrow">public profile</p>
    <h1>@Model.DisplayName</h1>
    <p>@DisplayRole(Model) • @DisplayLegalType(Model)</p>
    @if (Model.LegalType == AccountLegalTypes.Business)
    {
        <p>@Model.OrganizationName • ИНН @Model.Inn</p>
    }
    <div class="profile-tabs">
        <span class="tag">@(isOnline ? "В сети" : "Не в сети")</span>
        <span class="tag">★ @Model.Rating.ToString("0.00")</span>
        <span class="tag">@Model.ReviewsCount отзывов</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-soft" asp-controller="Inbox" asp-action="Thread" asp-route-id="@Model.Id">Написать</a>
        }
    </div>
</section>

<section class="admin-stats">
    <div class="stat-card neon-card"><span>Рейтинг</span><b>★ @Model.Rating.ToString("0.00")</b></div>
    <div class="stat-card neon-card"><span>Отзывы</span><b>@Model.ReviewsCount</b></div>
    <div class="stat-card neon-card"><span>Статус</span><b>@(isOnline ? "Online" : "Offline")</b></div>
</section>

<section class="section-block neon-card">
    <h2>Отзывы</h2>
    <div class="admin-list">
        @foreach (var review in reviews)
        {
            <div class="admin-row">
                <div>
                    <b>★ @review.Rating - @(review.Author?.DisplayName ?? "Пользователь")</b>
                    <p>@review.Text</p>
                    <small>@(review.Deal?.MarketItem?.Title ?? "Сделка") • @review.CreatedAt.ToString("dd.MM.yyyy")</small>
                </div>
            </div>
        }
    </div>
</section>

@if (User.Identity?.IsAuthenticated == true)
{
    <section class="auth-card neon-card">
        <h2>Пожаловаться на профиль</h2>
        <form asp-controller="Reports" asp-action="UserProfile" method="post" class="form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <label>Причина</label>
            <input name="reason" maxlength="600" placeholder="Спам, мошенничество, нарушение правил" />
            <button class="btn btn-soft" type="submit">Отправить жалобу</button>
        </form>
    </section>
}

@functions {
    string DisplayRole(ApplicationUser user) => user.AccountType == UserRoles.Creator ? "исполнитель" : "заказчик";

    string DisplayLegalType(ApplicationUser user) => user.LegalType == AccountLegalTypes.Business ? "ИП / юрлицо" : "физлицо";
}
